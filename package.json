{
  "name": "ta-character-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "tauri": "tauri",
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "check": "npm run prepare:sidecar && tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "pipeline:test": "node --test --test-isolation=none pipeline/pipeline.test.mjs",
    "comfy:test-transfer": "node scripts/test-comfy-transfer.mjs",
    "build": "tsc && vite build",
    "verify": "npm run check && npm run pipeline:test && cargo test --manifest-path src-tauri/Cargo.toml && npm run build",
    "bundle": "npm run prepare:sidecar && tauri build",
    "delivery": "powershell -ExecutionPolicy Bypass -File scripts/create-delivery.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@xyflow/react": "^12.11.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
